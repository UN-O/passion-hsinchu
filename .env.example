NEXT_PUBLIC_SITE_URL=

# /playground/* 開發用預覽頁的開關，只在本機開發時自己在 .env 設成 true——
# 正式環境（NODE_ENV=production）不管這個值是什麼都會被 proxy.ts 擋掉，
# 兩個條件都要成立才放行，見 proxy.ts 的說明。
ENABLE_PLAYGROUND=

DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# scripts/sync-roster.ts、scripts/rename-churches.ts 這類直接寫資料庫、跳過
# 網站本身的維護腳本，事後會打 /api/revalidate 清掉對應的 unstable_cache
# （見 app/api/revalidate/route.ts），不用乾等 TTL 到期。這把密鑰只是拿來
# 擋外人亂打這支 API（頂多讓網站多查幾次資料庫，不是資安漏洞），但一樣
# 不要進版控——隨便自己產生一串亂數字串即可，跟 BETTER_AUTH_SECRET 無關。
REVALIDATE_SECRET=

# Google 表單回覆試算表的匯出連結，知道連結就能存取整份原始名冊，
# 絕對不能寫死在程式碼裡，只能放在 .env。
CAMP_ROSTER_SHEET_URL=
CONFERENCE_ROSTER_SHEET_URL=

# 靈修內容的經文串接（YouVersion Platform API），在 platform.youversion.com
# 免費註冊拿 App Key。這把 Key 設計上是給前端公開用的，不是要保密的密鑰。
NEXT_PUBLIC_YOUVERSION_APP_KEY=

# Cloudflare R2（討論區附圖）。bucket 保持私有——圖片是未成年人在討論區
# 貼的內容，不能有「知道連結就能看」的公開網址；讀取一律走站上的
# /api/discussion/images/[id]，那裡會先驗 session 跟活動權限。
# R2_ENDPOINT 是 S3 API endpoint（Cloudflare 後台「S3 API」那一段，
# 不含 bucket 名稱）。Access Key 在 R2 → Manage API tokens 產生，
# 權限只要 Object Read & Write。
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
