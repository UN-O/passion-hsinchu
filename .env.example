# Neon Postgres 連線字串（用 pooled connection，結尾通常帶 -pooler）
DATABASE_URL=

# better-auth 用來簽章 session 的密鑰
# 產生方式： openssl rand -base64 32
BETTER_AUTH_SECRET=

# 本機開發用這個值；部署時改成正式站網址
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Authorized redirect URI 需要加入：
#   http://localhost:3000/api/auth/callback/google
#   https://<正式站網域>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
