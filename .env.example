# 這個部署的對外網址（結尾不要加斜線）。
# OG 分享預覽圖、canonical、sitemap、robots 都以這個為基準，設錯的話分享出去
# 不會顯示預覽圖。正式站可以留空（會用程式裡的預設值），測試站要設成自己的網域：
#   NEXT_PUBLIC_SITE_URL=https://test.passion-hsinchu.com
NEXT_PUBLIC_SITE_URL=

# Neon Postgres 連線字串（用 pooled connection，結尾通常帶 -pooler）
DATABASE_URL=

# better-auth 用來簽章 session 的密鑰
# 產生方式： openssl rand -base64 32
BETTER_AUTH_SECRET=

# 本機開發用這個值；部署時改成正式站網址
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Authorized redirect URI 需要加入：
#   http://localhost:3000/api/auth/callback/google
#   https://<正式站網域>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# scripts/sync-roster.ts 用。Google 表單「回覆」試算表 > 檔案 > 匯出 > 逗號分隔值(.csv)
# 這個網址本身就是免登入的存取權限，不要貼到 issue、聊天記錄或任何會進版控的地方。
# 若曾經外流，去 Google 試算表把分享設定改掉（例如關閉「知道連結的使用者」）即可讓舊網址失效。
CAMP_ROSTER_SHEET_URL=
CONFERENCE_ROSTER_SHEET_URL=
